{
  "name": "@groupoffice/neo-webclient",
  "version": "0.0.0",
  "private": true,
  "description": "neo.mjs webclient for Group Office (spike)",
  "type": "module",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "marked": "^18.2.1",
    "neo.mjs": "14.0.0",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "cssnano": "^9.8.0",
    "envinfo": "^7.21.0",
    "fs-extra": "^11.4.1",
    "inquirer": "^14.2.3",
    "postcss": "^8.5.30",
    "sass": "^1.105.1",
    "terser": "^5.51.2"
  },
  "scripts": {
    "build": "npm run build-themes",
    "build-themes": "node buildScripts/generateGoTheme.mjs && node node_modules/neo.mjs/buildScripts/build/themes.mjs -n -e dev -t all && npm run build-page-css",
    "build-page-css": "node buildScripts/buildPageCss.mjs",
    "audit-styles": "node buildScripts/auditStyles.mjs",
    "lint-summary": "node buildScripts/lintSummary.mjs"
  }
}
